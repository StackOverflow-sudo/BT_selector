{
  "benchmark_name": "bt_selection_benchmark_v2_stacking_probe",
  "environment": "ll4ma_cupboard_blocks",
  "description": "V2A probe task set focused on movable-on-movable stacking failures observed in V1. It keeps supported_by goals so the current evaluator and Isaac Gym hook can run without new predicate support.",
  "initial_state_policy": {
    "type": "seeded_variations",
    "planned_count_per_task": 5,
    "notes": "Uses available LL4MA/Points2Plans pickle timesteps as initial symbolic worlds."
  },
  "tasks": [
    {
      "task_id": "place_block3_on_block5",
      "instruction": "place block_3 on block_5",
      "goal_type": "supported_by",
      "target_predicates": [
        {"name": "supported_by", "source": "block_3", "target": "block_5"}
      ],
      "moved_object": "block_3",
      "support_object": "block_5",
      "priority": "v0_required",
      "notes": "Stable shelf-placement reference task."
    },
    {
      "task_id": "place_block1_on_block5",
      "instruction": "place block_1 on block_5",
      "goal_type": "supported_by",
      "target_predicates": [
        {"name": "supported_by", "source": "block_1", "target": "block_5"}
      ],
      "moved_object": "block_1",
      "support_object": "block_5",
      "priority": "v0_required",
      "notes": "Stable shelf-placement reference task with a different moved object."
    },
    {
      "task_id": "place_block2_on_block6",
      "instruction": "place block_2 on block_6",
      "goal_type": "supported_by",
      "target_predicates": [
        {"name": "supported_by", "source": "block_2", "target": "block_6"}
      ],
      "moved_object": "block_2",
      "support_object": "block_6",
      "priority": "v0_required",
      "notes": "Stable placement on the other fixed support."
    },
    {
      "task_id": "stack_block3_on_block1",
      "instruction": "stack block_3 on block_1",
      "goal_type": "supported_by",
      "target_predicates": [
        {"name": "supported_by", "source": "block_3", "target": "block_1"}
      ],
      "moved_object": "block_3",
      "support_object": "block_1",
      "priority": "v2_stacking_probe",
      "notes": "Known hard case from V1: correct_bt succeeded in only 1/5 simulation states."
    },
    {
      "task_id": "stack_block1_on_block3",
      "instruction": "stack block_1 on block_3",
      "goal_type": "supported_by",
      "target_predicates": [
        {"name": "supported_by", "source": "block_1", "target": "block_3"}
      ],
      "moved_object": "block_1",
      "support_object": "block_3",
      "priority": "v2_stacking_probe",
      "notes": "Reverses the V1 difficult pair to test whether instability is directional."
    },
    {
      "task_id": "stack_block2_on_block1",
      "instruction": "stack block_2 on block_1",
      "goal_type": "supported_by",
      "target_predicates": [
        {"name": "supported_by", "source": "block_2", "target": "block_1"}
      ],
      "moved_object": "block_2",
      "support_object": "block_1",
      "priority": "v2_stacking_probe",
      "notes": "Tests stacking onto the same support with a different moved object."
    },
    {
      "task_id": "stack_block4_on_block1",
      "instruction": "stack block_4 on block_1",
      "goal_type": "supported_by",
      "target_predicates": [
        {"name": "supported_by", "source": "block_4", "target": "block_1"}
      ],
      "moved_object": "block_4",
      "support_object": "block_1",
      "priority": "v2_stacking_probe",
      "notes": "Tests whether block_1 is generally unstable as a support."
    },
    {
      "task_id": "stack_block3_on_block2",
      "instruction": "stack block_3 on block_2",
      "goal_type": "supported_by",
      "target_predicates": [
        {"name": "supported_by", "source": "block_3", "target": "block_2"}
      ],
      "moved_object": "block_3",
      "support_object": "block_2",
      "priority": "v2_stacking_probe",
      "notes": "Tests whether block_3 stacking failure is support-specific."
    }
  ],
  "candidate_types": [
    "correct_bt",
    "missing_precondition_bt",
    "wrong_object_bt",
    "wrong_support_bt",
    "redundant_bt",
    "unsafe_or_invalid_bt"
  ]
}
